	local url = S.pfp_url
	if not url or url == "" then
		D.notify("Profile picture", "Paste a direct image link first.", {icon = "triangle-alert", sound = "error"})
		return
	end
	D.notify("Profile picture", "Downloading...", {icon = "download", dur = 2})
